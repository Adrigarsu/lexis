# Copy this file to .env.local and fill in the values. Never commit .env files.
# Local values: run `pnpm exec supabase status` with the local database started.
# Cloud values: Supabase dashboard, Project Settings > API Keys (once the cloud project exists, D-158).

# Supabase API URL (local: http://127.0.0.1:55321)
VITE_SUPABASE_URL=

# Supabase publishable key (safe in the browser; RLS protects the data)
VITE_SUPABASE_PUBLISHABLE_KEY=
