{
  "name": "lexis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @lexis/design-tokens build && pnpm --filter @lexis/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install --reset-hooks-path",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @lexis/e2e test",
    "test:e2e:full": "pnpm --filter @lexis/e2e test:full",
    "test:db": "supabase test db"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lexis/config": "workspace:*",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "supabase": "3.2.0",
    "vitest": "^5.1.1"
  }
}
